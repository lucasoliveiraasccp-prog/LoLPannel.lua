local function createToggle(label, order, initial, callback)
	local state = initial
	local button = create("TextButton", {
		Name = "Toggle_" .. label,
		LayoutOrder = order,
		BackgroundColor3 = COLORS.off,
		Text = "",
		TextColor3 = COLORS.text,
		TextScaled = true,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false,
		Parent = toggleGrid,
	})
	addCorner(button, 8)
	create("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 8, Parent = button })
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
		Parent = button,
	})

	local function render()
		button.Text = label .. (state and " ON" or " OFF")
		button.BackgroundColor3 = state and COLORS.on or COLORS.off
	end
	render()

	button.Activated:Connect(function()
		state = not state
		render()
		callback(state)
	end)

	return {
		Set = function(value)
			state = value
			render()
		end,
	}
end

