-- Módulo: Escala responsiva
--------------------------------------------------------------------------------
local scaleObjects = {}

local function computeScale()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	return math.clamp(math.min(viewport.X, viewport.Y) / 640, 0.75, 1.4)
end

local function registerScale(guiObject)
	local scale = create("UIScale", { Scale = computeScale(), Parent = guiObject })
	table.insert(scaleObjects, scale)
	return scale
end

local function refreshScale()
	local value = computeScale()
	for i = #scaleObjects, 1, -1 do
		local scale = scaleObjects[i]
		if scale.Parent then
			scale.Scale = value
		else
			table.remove(scaleObjects, i)
		end
	end
end

local viewportConnection
local function watchCamera()
	if viewportConnection then
		viewportConnection:Disconnect()
		viewportConnection = nil
	end
	local camera = workspace.CurrentCamera
	if camera then
		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScale)
		refreshScale()
	end
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

--------------------------------------------------------------------------------
-- Módulo: Arrastar (mouse e toque)
-- Os alvos usam AnchorPoint 0.5/0.5 e Position apenas em escala, por isso a
-- posição independe do UIScale e da resolução.
--------------------------------------------------------------------------------
local function makeDraggable(handle, target, options)
	options = options or {}
	local activeInput = nil
	local startPoint = nil
	local startPosition = nil
	local moved = false

	handle.InputBegan:Connect(function(input)
		if not isPointerInput(input) or activeInput then
			return
		end
		activeInput = input
		startPoint = input.Position
		startPosition = target.Position
		moved = false

		if options.onPress then
			options.onPress()
		end

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End and activeInput == input then
				activeInput = nil
				if options.onRelease then
					options.onRelease(moved)
				end
			end
		end)
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not activeInput then
			return
		end
		if activeInput.UserInputType == Enum.UserInputType.Touch then
			if input ~= activeInput then
				return
			end
		elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local delta = input.Position - startPoint
		if not moved and delta.Magnitude >= CONFIG.DRAG_THRESHOLD then
			moved = true
		end

		if moved and (not options.canDrag or options.canDrag()) then
			local size = screenGui.AbsoluteSize
			if size.X <= 0 or size.Y <= 0 then
				return
			end
			local halfX = math.min(target.AbsoluteSize.X / 2 / size.X, 0.5)
			local halfY = math.min(target.AbsoluteSize.Y / 2 / size.Y, 0.5)
			local x = math.clamp(startPosition.X.Scale + delta.X / size.X, halfX, 1 - halfX)
			local y = math.clamp(startPosition.Y.Scale + delta.Y / size.Y, halfY, 1 - halfY)
			target.Position = UDim2.fromScale(x, y)
		end
	end)
end

--------------------------------------------------------------------------------
-- Módulo: Chat
--------------------------------------------------------------------------------
local function sendChat(text)
	local ok = pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channels = TextChatService:WaitForChild("TextChannels", 3)
			local channel = channels and channels:WaitForChild("RBXGeneral", 3)
			if not channel then
				error("canal indisponivel")
			end
			channel:SendAsync(text)
		else
			local events = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 3)
			local say = events and events:WaitForChild("SayMessageRequest", 3)
			if not say then
				error("chat legado indisponivel")
			end
			say:FireServer(text, "All")
		end
	end)
	return ok
end


