	if CONFIG.SHIFTLOCK_KEYS[input.KeyCode] then
		setShiftLock(not State.shiftLock)
	elseif input.KeyCode == Enum.KeyCode.Delete or input.KeyCode == Enum.KeyCode.Backspace then
		deleteSelected()
	end
end)

